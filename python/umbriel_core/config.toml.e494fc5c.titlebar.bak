# my config
[general]
mod_key = "Ctrl" # main modifier
show_cheatsheet = false

[environment]
QT_QPA_PLATFORM = "wayland"

[keybinds]
# launchers
"super+Return" = "spawn kitty"
"super+q" = "window-close"

[[window_rule]]
match = { app_id = "^org.mozilla.firefox$" }
opacity = 0.9

[colors.title_bar]
background = "#445566FF"
